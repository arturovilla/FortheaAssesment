# Backend env-var template. Copy to `.env.local` and fill in the REPLACE_ME values.
# `.env.local` is gitignored; this file (`.env.example`) is committed.

# === Database ===
# Two URLs, two roles (migration 0004):
#
#   DATABASE_URL        → forthea_app  (non-superuser; RLS applies)
#                         Used by the FastAPI app. Tenant isolation is enforced
#                         in the database itself for this connection.
#
#   ADMIN_DATABASE_URL  → forthea      (superuser; bypasses RLS, has DDL)
#                         Used by alembic for migrations. Optional — if unset,
#                         alembic falls back to DATABASE_URL, which is correct
#                         for a fresh clone before RLS is in play.
#
# The `+psycopg` selects the psycopg v3 driver (vs the older psycopg2).
DATABASE_URL=postgresql+psycopg://forthea_app:forthea_app@localhost:5432/forthea
ADMIN_DATABASE_URL=postgresql+psycopg://forthea:forthea@localhost:5432/forthea

# === Auth (Clerk — https://clerk.com) ===
# Get these from your Clerk app → API Keys.
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME
CLERK_JWKS_URL=https://REPLACE_ME.clerk.accounts.dev/.well-known/jwks.json

# === Enrichment (FRED — https://fred.stlouisfed.org/docs/api/api_key.html) ===
FRED_API_KEY=REPLACE_ME

# === Blob storage ===
# Local dev uses a filesystem stub. Production swaps to Azure Blob.
BLOB_STORAGE_TYPE=local
BLOB_STORAGE_PATH=/tmp/forthea-blob

# === App ===
APP_ENV=local
LOG_LEVEL=INFO

# === CORS ===
# Comma-separated origins allowed to call the API. Next.js dev server is the
# default; add staging/prod URLs as the dashboard gets deployed.
CORS_ORIGINS=http://localhost:3000
