# Anything matched here is invisible to `COPY .` and to the build context —
# both speeds up builds and keeps secrets/junk out of the final image.

# ---- Virtual environment (venv-in-folder layout) ----
bin/
include/
lib/
lib64/
share/
pyvenv.cfg

# ---- Data generator: source ships inside the image so it can run via
#      `docker exec -it forthea-backend python data-generator/...`.
#      Generated JSON files do NOT ship — they're bind-mounted at runtime
#      so they end up on the host where the dashboard upload UI can pick
#      them up.
data-generator/output/
data-generator/__pycache__/

# ---- Secrets — env values come from the orchestrator at runtime ----
.env
.env.local
.env.*.local

# ---- Python bytecode / caches ----
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- OS / IDE noise ----
.DS_Store
.vscode/
.idea/
*.swp

# ---- VCS ----
.git/
.gitignore

# ---- Build artifacts ----
build/
dist/
*.egg-info/
